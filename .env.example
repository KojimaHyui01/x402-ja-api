# ---- Server ----
PORT=4021
# Permanent public URL (x402scan rejects tunnels like ngrok / trycloudflare)
PUBLIC_BASE_URL=http://localhost:4021
SERVICE_NAME=ja-normalize
# Shown publicly in openapi.json (registries use it for ownership checks)
CONTACT_EMAIL=yux0115@gmail.com

# ---- Payment ----
# EVM address that receives USDC. Use a fresh wallet dedicated to this service.
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
# base-sepolia (testnet, free) | base (mainnet, real USDC)
X402_NETWORK=base-sepolia
# Optional override. Testnet default: https://x402.org/facilitator
# FACILITATOR_URL=

# Required only when X402_NETWORK=base (Coinbase CDP facilitator; 1,000 free settlements then $0.001 each)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Free calls per client IP per day before x402 payment is required (0 = always pay)
FREE_QUOTA_PER_DAY=20

# ---- Operator dashboard ----
# Required to read /stats (bearer header, basic-auth password, or ?token=). 16+ chars.
# Unset = /stats is disabled (503) rather than public. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# STATS_TOKEN=
# Salt for the hashed visitor ids on /stats. Set it to keep ids comparable across deploys;
# unset means a fresh salt each boot, so ids cannot be matched against older log lines.
# CLIENT_ID_SALT=

# ---- Data sources ----
# 国税庁 法人番号Web-API アプリケーションID (apply at https://www.houjin-bangou.nta.go.jp/webapi/ — issuance takes 2-4 weeks)
# HOJIN_APP_ID=

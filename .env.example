# ---- Server ----
PORT=4021
# Permanent public URL (x402scan rejects tunnels like ngrok / trycloudflare)
PUBLIC_BASE_URL=http://localhost:4021
SERVICE_NAME=ja-normalize

# ---- Payment ----
# EVM address that receives USDC. Use a fresh wallet dedicated to this service.
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
# base-sepolia (testnet, free) | base (mainnet, real USDC)
X402_NETWORK=base-sepolia
# Optional override. Testnet default: https://x402.org/facilitator
# FACILITATOR_URL=

# Required only when X402_NETWORK=base (Coinbase CDP facilitator; 1,000 free settlements then $0.001 each)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# ---- Data sources ----
# 国税庁 法人番号Web-API アプリケーションID (apply at https://www.houjin-bangou.nta.go.jp/webapi/ — issuance takes 2-4 weeks)
# HOJIN_APP_ID=
